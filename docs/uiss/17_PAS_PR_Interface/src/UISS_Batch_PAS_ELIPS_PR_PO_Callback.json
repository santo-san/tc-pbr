 "general": {
  "objective": [
   "To write the PAS PR number and the released PAS PO number (status 44) back to the ELIPS ielp.SA_DETAIL rows of the SA that was interfaced to PAS.",
   "To run as a scheduled Talend job, DB-to-DB, without API and without changing PAS data.",
   "To update only the correct ielp.SA_DETAIL rows, idempotently and per SA transaction, and log every result."
  ],
