      "Trigger",
      "Online: [Choose File] in the Upload Excel accordion of Route Mileage"
     ],
     [
      "Transaction",
      "Same call, one transaction, all-or-nothing"
     ],
     [
      "Lock",
      "One open upload per user"
     ],
     [
      "Limits",
      "1,000 rows (TBD)"
     ]
    ]
   }
