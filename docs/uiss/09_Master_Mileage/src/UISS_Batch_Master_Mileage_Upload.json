      "id": "v",
      "label": "Upload: validate, then save",
      "type": "process"
     },
     {
      "id": "t",
      "label": "TB_T_MILEAGE_UPLOAD / TB_R_MILEAGE_UPLOAD_LOG",
      "type": "db"
     },
     {
      "id": "x",
      "label": "Error modal: Row / Column / Error",
      "type": "screen"
     },
     {
      "id": "m",
      "label": "ielp.TB_M_MILEAGE",
      "type": "db"
     }
    ],
    "edges": [
     {
      "from": "s",
      "to": "v"
     },
     {
      "from": "v",
      "to": "t"
     },
     {
      "from": "v",
      "to": "x",
      "label": "any error"
     },
     {
      "from": "v",
      "to": "m",
      "label": "all valid: 1 transaction"
     }
    ]
   }
  },
  "inputs": [
