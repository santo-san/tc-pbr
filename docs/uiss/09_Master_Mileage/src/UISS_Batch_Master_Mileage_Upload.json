   "msg_id": "TBD",
   "message": "Route Mileage upload <UPLOAD_ID> failed: <DB_ERROR>. Nothing was saved.",
   "action": {
    "system": "Rollback; log ERROR",
    "user": "Try again"
   }
  },
  {
   "event": "Save",
   "cause": "Saved",
   "type": "Info",
   "msg_id": "TBD",
   "message": "Upload completed: <n> route(s) created, <m> route(s) updated.",
