 "func_desc": [
  {
   "type": "heading",
   "text": "DESCRIPTION",
   "num": "4."
  },
  {
   "type": "text",
   "text": "Backend of the Excel upload on the Route Mileage screen (Master > Mileage). One call, like the Planning Order upload: [Choose File] uploads and validates the file; with any error nothing is saved and the Row / Column / Error list is returned (modal on the screen); without errors all New and Update rows are saved at once in one transaction.",
   "level": 1,
   "bold": false
  },
  {
   "type": "text",
   "text": "4.1 Template (Download Template: Template_Route_Mileage.xlsx)",
   "level": 1,
   "bold": true
  },
  {
   "type": "table",
   "level": 1,
   "columns": [
    {
     "title": "Column",
     "width": 9
    },
    {
     "title": "Rule",
     "width": 27
    },
    {
     "title": "Example",
     "width": 9
    }
   ],
   "rows": [
    [
     "FROM CODE",
     "Mandatory; active Master Location code; upper case",
     "SNT"
    ],
    [
     "TO CODE",
     "Mandatory; active Master Location code; <> FROM CODE",
     "CKR"
    ],
    [
     "MILEAGE (KM)",
     "Mandatory; number > 0; max 2 decimals; comma = decimal sign",
     "42 / 16,5"
    ]
   ],
   "row_lines": "all"
  },
  {
   "type": "item",
   "marker": "a.",
   "text": "Sheets: Route Mileage (header + 2 examples), Active Locations (code, name), Notes. Title rows above the header are allowed; other columns are ignored. Max 1,000 data rows (TBD).",
   "level": 2
  },
  {
   "type": "text",
   "text": "4.2 Row validation (all errors of a row are collected)",
   "level": 1,
   "bold": true
  },
  {
   "type": "table",
   "level": 1,
   "columns": [
    {
     "title": "ID",
     "width": 5
    },
    {
     "title": "Check",
     "width": 22
    },
    {
     "title": "Result",
     "width": 18
    }
   ],
   "rows": [
    [
     "MM-22",
     "Mandatory From / To / Mileage",
     "Location From / To / Mileage is required."
    ],
    [
     "MM-22",
     "From / To active in Master Location",
     "Location X is not an active location in Master Location."
    ],
    [
     "MM-22",
     "From <> To",
     "Location From and Location To cannot be the same."
    ],
    [
     "MM-22",
     "Mileage > 0, 2 decimals",
     "Mileage must be greater than 0 KM."
    ],
    [
     "MM-23",
     "Route repeated in the file",
     "Route is repeated in the file (row n)."
    ],
    [
     "MM-23",
     "Existing route Inactive",
     "Route X -> Y exists but is Inactive; activate it on the screen first."
    ],
    [
     "MM-24",
     "Existing Active route",
     "same mileage = SAME (skipped); other mileage = UPDATE"
    ],
    [
     "MM-24",
     "Route not existing",
     "NEW"
    ]
   ],
   "row_lines": "all"
  },
  {
   "type": "column_break"
  },
  {
   "type": "text",
   "text": "4.3 Save rules",
   "level": 1,
   "bold": true
  },
  {
   "type": "item",
   "marker": "a.",
   "text": "All-or-nothing (MM-25): saved only when ERROR_ROWS = 0 and ADDED + UPDATED > 0, in the same call (no preview / confirm). The routes are re-read with UPDLOCK inside the transaction.",
   "level": 2
  },
  {
   "type": "item",
   "marker": "b.",
   "text": "NEW = insert Active with audit; UPDATE = mileage, updated by / date, VERSION + 1, created by / date kept; SAME = nothing written.",
   "level": 2
  },
  {
   "type": "item",
   "marker": "c.",
   "text": "One upload per user at a time (lock while PROCESSING).",
   "level": 2
  },
  {
   "type": "text",
   "text": "4.4 Open questions",
   "level": 1,
   "bold": true
  },
  {
   "type": "table",
   "level": 1,
   "columns": [
    {
     "title": "ID",
     "width": 5
    },
    {
     "title": "Question",
     "width": 40
    }
   ],
   "rows": [
    [
     "OQ-01",
     "Existing route by upload: update (implemented) or reject (new routes only)?"
    ],
    [
     "OQ-02",
     "Inactive route in the file: error (implemented) or update and re-activate?"
    ],
    [
     "OQ-03",
     "Max rows (1,000), partial save of valid rows instead of all-or-nothing?"
    ],
    [
     "OQ-04",
     "Mileage history table needed (proposed TB_H_MILEAGE)?"
    ],
    [
     "OQ-05",
     "Keep temp rows of error uploads how many days?"
    ],
    [
     "OQ-06",
     "Physical table / column names of Route Mileage Master and the role allowed to upload"
    ]
   ],
   "row_lines": "all"
  }
