 "general": {
  "objective": [
   "To create the monthly PR per Logistics Partner: Monthly PR - Fixed Cost (E-Catalogue Monthly Cost) and Route-Based PR for LP operations.",
   "To calculate the route-based plan from Route Percentage, TMMIN Calendar working days, Order Sharing (Master KPI) and E-Catalogue Mileage Cost, and show it per LP.",
   "To support additional PR sequences without duplicated cost components, follow the creation period rule and start the existing PR approval (SH skipped when the Section Head creates the PR)."
  ],
  "display_order": [
   {
    "section": "List Summary",
    "fields": [
     {
      "field": "Trucking Company code",
      "order": "Ascending"
     }
    ]
   },
   {
    "section": "PR Detail Pop-up",
    "fields": [
     {
      "field": "Route Percentage list order",
      "order": "Ascending"
     }
    ]
   }
  ],
  "buttons": [
   {
    "name": "Parameters",
    "function": "PR Creation Type, Operational Month, Logistics Partner: to set the PR to create."
   },
   {
    "name": "Generate Route Plan",
    "function": "To calculate and show the List Summary."
   },
   {
    "name": "Create PR",
    "function": "To create the PR for the selected Ready rows after confirmation."
   },
   {
    "name": "Export",
    "function": "To export the List Summary or the Route Plan Detail to Excel."
   },
   {
    "name": "Cancel",
    "function": "Clear criteria and reset the screen to its initial value."
   },
   {
    "name": "Search / Column",
    "function": "To filter rows by trucking company and to show / hide columns."
   },
   {
    "name": "Select",
    "function": "To select the Ready rows to be created."
   },
   {
    "name": "Detail",
    "function": "To open the PR Detail pop-up with route plan and cost breakdown."
   }
  ],
