  "steps": [
   {
    "text": "Log message no. 1. Retrieve DTP_QUEUE_BATCH_SIZE and DTP_QUEUE_MAX_ATTEMPT from System Master (TB_M_SYSTEM, TBD) (TBD).",
    "children": [
     "Not configured: log message no. 3. Stop.",
     "DB connection error: log message no. 2. Stop."
    ]
   },
   {
    "text": "Select up to the batch size from TB_R_DTP_RECORD WHERE STATUS IN ('SUBMITTED', 'QUEUED') ORDER BY SUBMITTED_DT, DTP_REC_ID (row lock, skip locked); SUBMITTED records are set to QUEUED first.",
    "children": [
     "None: log message no. 4. End."
    ]
   },
   {
    "text": "Per record (own transaction): set STATUS 'PROCESSING', ATTEMPT_CNT + 1, history."
   },
   {
    "text": "Re-check that LP is active and FROM / TO are still in the data mapping.",
    "children": [
     "Not valid: go to step 7 with message no. 5."
    ]
   },
   {
    "text": "Create the Daily order (Planning Order) and its first cycle (DTP Creation Release) with a new ORDER_NO (refer 4.2).",
    "children": [
     "Error / timeout: rollback the order, go to step 7 with message no. 6."
    ]
   },
   {
    "text": "Set the record PROCESSED with ORDER_NO, clear FAIL_REASON, history; commit. Log message no. 8. The order is visible for the LP Admin (Daily Monitoring)."
   },
   {
    "text": "Set the record FAILED with FAIL_REASON, history; commit. The planner can Retry (status back to QUEUED).",
    "children": [
     "ATTEMPT_CNT >= max: log message no. 7."
    ]
   },
   {
    "text": "Next record; when all are handled, log message no. 9. Exit."
   }
  ]
 },
