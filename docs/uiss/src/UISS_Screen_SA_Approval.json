 "general": {
  "objective": [
   "To let VPLD perform Service Acceptance (GR) for deliveries finished by the LP, supporting the 3-way matching PR -> PO -> GR/SA.",
   "To validate each delivery against the applicable TC-PBR PO: route, Total KM, PO, rate and calculated cost, before approval.",
   "To generate the SA Number (ILS/TR/{code}/{YYMMDD}{NNNN}), save the SA with a calculation snapshot and update Daily Monitoring, without duplicate SA.",
   "To let VPLD also perform SA for the monthly truck cost (Fixed Cost PR / PO, truck + driver rental per month) once the monthly PO is released."
  ],
  "display_order": [
   {
    "section": "Order List",
    "fields": [
     {
      "field": "Order Date",
      "order": "Ascending"
     },
     {
      "field": "Order Number",
      "order": "Ascending"
     }
    ]
   }
  ],
  "buttons": [
   {
    "name": "Search",
    "function": "To retrieve eligible deliveries by Order From / To."
   },
   {
    "name": "Clear",
    "function": "To reset the criteria."
   },
   {
    "name": "Regular / Inter Plant Trip",
    "function": "To switch the trip tab."
   },
   {
    "name": "Monthly Truck",
    "function": "To show released monthly (Fixed Cost) PO."
   },
   {
    "name": "Select All",
    "function": "To select all Ready rows."
   },
   {
    "name": "Approve",
    "function": "To approve the selected deliveries (confirmation)."
   },
   {
    "name": "Calculation detail",
    "function": "To show the calculation of a row."
   },
   {
    "name": "Order Detail",
    "function": "To open the Daily Monitoring Order Detail."
   },
   {
    "name": "Kolom",
    "function": "To show / hide columns."
   }
  ],
