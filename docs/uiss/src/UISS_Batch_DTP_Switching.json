 "func_desc": [
  {
   "type": "heading",
   "text": "DESCRIPTION",
   "num": "4."
  },
  {
   "type": "text",
   "text": "DTP Switching rolls back DTP records already submitted to the trucking company, as long as the driver has not started, so they can be corrected and submitted again. It is started from the DTP Creation grid (button DTP Switching / row option) after the confirmation 'Confirm DTP Switching'. Existing statuses are reused; no new status is created.",
   "level": 1,
   "bold": false
  },
  {
   "type": "text",
   "text": "4.1 Eligibility (checked on the screen and again in step 3)",
   "level": 1,
   "bold": true
  },
  {
   "type": "table",
   "level": 1,
   "columns": [
    {
     "title": "DTP status",
     "width": 9
    },
    {
     "title": "Linked Daily order",
     "width": 14
    },
    {
     "title": "Result",
     "width": 22
    }
   ],
   "rows": [
    [
     "Available / Ready / Validation Error",
     "-",
     "Not submitted (log message no. 6)"
    ],
    [
     "Submitted / Queued",
     "not created",
     "Allowed - queue entry deleted"
    ],
    [
     "Failed",
     "not created",
     "Allowed"
    ],
    [
     "Processing",
     "being created",
     "Not eligible (log message no. 7)"
    ],
    [
     "Processed",
     "Planning Order / Order Release, no cycle Start Cycle",
     "Allowed - order cancelled, truck released"
    ],
    [
     "Processed",
     "Start / Finish / SA / PO or a cycle started",
     "Driver started (log message no. 8)"
    ],
    [
     "Processed",
     "order not found / cancelled",
     "Not eligible (log message no. 7)"
    ]
   ],
   "row_lines": "all"
  },
  {
   "type": "item",
   "marker": "a.",
   "text": "Driver Started = Daily order status not in (Planning Order, Order Release) OR any cycle START_DT not null.",
   "level": 2
  },
  {
   "type": "item",
   "marker": "b.",
   "text": "VERSION of the record must equal the version shown on the screen (stale data -> not eligible).",
   "level": 2
  },
  {
   "type": "text",
   "text": "4.2 Batch rule",
   "level": 1,
   "bold": true
  },
  {
   "type": "item",
   "marker": "a.",
   "text": "All-or-nothing per request, as Submit (DT-15): one record failing the re-check rejects the whole request; the response lists every failed record with its reason. Partial success: OQ-04.",
   "level": 2
  },
  {
   "type": "text",
   "text": "4.3 Concurrency",
   "level": 1,
   "bold": true
  },
  {
   "type": "item",
   "marker": "a.",
   "text": "Row locks on the records and orders inside the transaction; the Driver APK Start Order and the queue service check the same rows, so either the driver start or the rollback wins, never both.",
   "level": 2
  },
  {
   "type": "item",
   "marker": "b.",
   "text": "The queue service skips a record whose status is no longer Submitted / Queued / Processing.",
   "level": 2
  },
  {
   "type": "column_break"
  },
  {
   "type": "text",
   "text": "4.4 Data kept for audit",
   "level": 1,
   "bold": true
  },
  {
   "type": "item",
   "marker": "a.",
   "text": "Nothing is physically deleted except the queue entry: the Daily order is logically cancelled, assignment rows are deactivated, all history rows are added; the old Order No and an order snapshot are stored in TB_H_DTP_SWITCH.",
   "level": 2
  },
  {
   "type": "text",
   "text": "4.5 After rollback",
   "level": 1,
   "bold": true
  },
  {
   "type": "item",
   "marker": "a.",
   "text": "Record Available: Edit, Delete (Excel / Manual), Select and Submit work as before; a new submission creates a new Daily order with a new Order No (OQ-06).",
   "level": 2
  },
  {
   "type": "item",
   "marker": "b.",
   "text": "Screen: success 'DTP rollback completed successfully.'; grid refreshed.",
   "level": 2
  },
  {
   "type": "text",
   "text": "4.6 Open questions",
   "level": 1,
   "bold": true
  },
  {
   "type": "table",
   "level": 1,
   "columns": [
    {
     "title": "ID",
     "width": 5
    },
    {
     "title": "Question",
     "width": 40
    }
   ],
   "rows": [
    [
     "OQ-01",
     "Logical cancel of the Daily order (proposed) or delete? Visible in Daily Monitoring?"
    ],
    [
     "OQ-02",
     "Who may use DTP Switching (VPLD Planner only, or IELP Admin)? Reason mandatory?"
    ],
    [
     "OQ-03",
     "Notify LP Admin / driver when an accepted / assigned order is rolled back?"
    ],
    [
     "OQ-04",
     "All-or-nothing (implemented) or partial success with summary?"
    ],
    [
     "OQ-05",
     "Allowed for planning dates outside the DTP date range?"
    ],
    [
     "OQ-06",
     "Re-use the old Order No on re-submission?"
    ],
    [
     "OQ-07",
     "Physical name of the queue table and the CANCEL_* columns of Daily Order."
    ]
   ],
   "row_lines": "all"
  }
 ],
 "func_desc_layout": "two",
 "logging_messages": [
  {
   "event": "Process start",
   "cause": "DTP Switching request received",
   "type": "Info",
   "msg_id": "TBD",
   "message": "DTP Switching <REQUEST_ID> started by <USER>: <n> record(s).",
   "action": {
    "system": "Insert request log (PROCESSING)",
    "user": "-"
   }
  },
  {
   "event": "Process start",
   "cause": "Same request id already processed / processing",
   "type": "Warning",
   "msg_id": "TBD",
   "message": "DTP Switching request <REQUEST_ID> already processed, result returned.",
   "action": {
    "system": "Return stored result, no change",
    "user": "-"
   }
  },
  {
   "event": "Authorization",
   "cause": "User is not VPLD Planner (DT-01)",
   "type": "Error",
   "msg_id": "TBD",
   "message": "Only the VPLD Planner can create DTP.",
   "action": {
    "system": "Reject request (403)",
    "user": "Login as VPLD Planner"
   }
  },
  {
   "event": "Parameter check",
   "cause": "No record selected",
   "type": "Error",
   "msg_id": "TBD",
   "message": "Select at least one submitted DTP record that the driver has not started.",
   "action": {
    "system": "Reject request (400)",
    "user": "Select records"
   }
  },
  {
   "event": "Connect to database server",
   "cause": "Cannot connect / lock timeout",
   "type": "Critical",
   "msg_id": "TBD",
   "message": "Database cannot be connected.",
   "action": {
    "system": "Stop; nothing changed",
    "user": "Retry / contact system administrator"
   }
  },
  {
   "event": "Record validation",
   "cause": "Record not submitted (Available / Ready / Validation Error)",
   "type": "Error",
   "msg_id": "TBD",
   "message": "DTP <DTP_REC_ID> has not been submitted. There is nothing to roll back.",
   "action": {
    "system": "Reject request (409), nothing changed",
    "user": "Refresh"
   }
  },
  {
   "event": "Record validation",
   "cause": "Record Processing, version changed, already rolled back or order missing",
   "type": "Error",
   "msg_id": "TBD",
   "message": "DTP <DTP_REC_ID> is no longer eligible for rollback. Please refresh the data and try again.",
   "action": {
    "system": "Reject request (409), nothing changed",
    "user": "Refresh and try again"
   }
  },
  {
   "event": "Record validation",
   "cause": "Driver started: order not Planning Order / Order Release, or a cycle has Start Cycle",
   "type": "Error",
   "msg_id": "TBD",
   "message": "DTP <DTP_REC_ID> cannot be rolled back because the driver has already started the process (order <ORDER_NO> <STATUS>).",
   "action": {
    "system": "Reject request (409), nothing changed",
    "user": "-"
   }
  },
  {
   "event": "Rollback update",
   "cause": "DB error on any update / insert",
   "type": "Error",
   "msg_id": "TBD",
   "message": "DTP Switching <REQUEST_ID> failed: <DB_ERROR>. Transaction rolled back.",
   "action": {
    "system": "Rollback all; request log ERROR (500)",
    "user": "Try again"
   }
  },
  {
   "event": "Rollback update",
   "cause": "Record rolled back",
   "type": "Info",
   "msg_id": "TBD",
   "message": "DTP <DTP_REC_ID> rolled back from <PREV_STATUS> to <NEW_STATUS>; order <ORDER_NO> cancelled; truck <PLATE_NO> released.",
   "action": {
    "system": "-",
    "user": "-"
   }
  },
  {
   "event": "Process end",
   "cause": "All records rolled back",
   "type": "Info",
   "msg_id": "TBD",
   "message": "DTP Switching <REQUEST_ID> finished: <n> record(s) rolled back.",
   "action": {
    "system": "Request log SUCCESS (200)",
    "user": "-"
   }
  },
  {
   "event": "Processing",
   "cause": "Unexpected system error",
   "type": "Critical",
   "msg_id": "TBD",
   "message": "DTP Switching <REQUEST_ID> stopped: <ERROR>.",
   "action": {
    "system": "Rollback all; request log ERROR; inform system owner by e-mail (TBD)",
    "user": "Contact system administrator"
   }
  }
 ],
