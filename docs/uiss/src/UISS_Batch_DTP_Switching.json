 "general": {
  "objective": [
   "To roll back DTP records that were submitted to the trucking company while the driver has not started, so they can be corrected and submitted again through DTP Creation.",
   "To revert every related record in one transaction (DTP record, queue, Daily order, truck assignment, driver sync) and keep the history for audit.",
   "In case of any validation failure or error nothing is changed; the reason is returned to the screen."
  ],
  "operation_flow": {
   "flow": {
    "direction": "TB",
    "nodes": [
     {
      "id": "a",
      "label": "DTP Creation grid: DTP Switching",
      "type": "screen"
     },
     {
      "id": "b",
      "label": "Confirm DTP Switching",
      "type": "screen"
     },
     {
      "id": "p",
      "label": "DTP Switching process (1 transaction)",
      "type": "process"
     },
     {
      "id": "r",
      "label": "TB_R_DTP_RECORD -> Available",
      "type": "db"
     },
     {
