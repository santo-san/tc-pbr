 "general": {
  "objective": [
   "To let General Affair Department approve or reject POs manually before the auto approve deadline.",
   "To show the auto approve deadline (PO date + Day + 1 from System Master) and let IP Admin run the auto approve job.",
   "To return the PR to PR Creation (resubmit required) when the PO is rejected."
  ],
  "display_order": [
   {
    "section": "List",
    "fields": [
     {
      "field": "Production Month",
      "order": "Ascending"
     },
     {
      "field": "PO Number",
      "order": "Ascending"
     }
    ]
   },
   {
    "section": "Detail PO - Route",
    "fields": [
     {
      "field": "Route",
      "order": "Ascending"
     }
    ]
   },
   {
    "section": "Detail PO - Approval History",
    "fields": [
     {
      "field": "Action date time",
      "order": "Descending"
     }
    ]
   }
  ],
  "buttons": [
   {
    "name": "Search",
    "function": "To retrieve records according to the specified criteria."
   },
   {
    "name": "Clear",
    "function": "Clear criteria and reset the screen to its initial value."
   },
   {
    "name": "Kolom",
    "function": "To show / hide column groups of the list."
   },
   {
    "name": "Select",
    "function": "To tick documents to be processed (row and select-all check box)."
   },
   {
    "name": "Approve",
    "function": "To approve the ticked POs after confirmation."
   },
   {
    "name": "Reject",
    "function": "To reject the ticked POs with Reason after confirmation."
   },
   {
    "name": "Run Auto Approve",
    "function": "IP Admin: to run the PO auto approve job immediately."
   },
   {
    "name": "PO Number link",
    "function": "To open Detail PO modal (route detail and approval history)."
   },
   {
    "name": "Download",
    "function": "To download the route detail of the PO as CSV."
   },
   {
    "name": "Modal Approve",
    "function": "To approve the PO shown in the detail modal."
   },
   {
    "name": "Modal Reject",
    "function": "To reject the PO shown in the detail modal."
   },
   {
    "name": "Submit",
    "function": "Approve / Reject button in the confirmation modal: to save the decision."
   },
   {
    "name": "Batal",
    "function": "To close the confirmation modal without saving."
   },
   {
    "name": "Close (x)",
    "function": "To close the modal."
   }
  ],
