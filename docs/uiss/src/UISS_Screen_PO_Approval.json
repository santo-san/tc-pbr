   "bold": true
  },
  {
   "type": "item",
   "marker": "a.",
   "text": "'PO Number' blank, 'Prod. Month From' = Blank, 'Prod. Month To' blank, 'Status' = 'Pending'.",
   "level": 2
  },
  {
   "type": "item",
   "marker": "b.",
   "text": "List shows POs within the user data scope matching the initial criteria, sorted by Production Month then PO Number ascending, 10 rows per page.",
   "level": 2
  },
  {
   "type": "text",
   "text": "5.2.2 Button Operation",
   "level": 1,
   "bold": true
  },
  {
   "type": "item",
   "marker": "a.",
   "text": "User clicks 'Search'.",
   "level": 2
  },
  {
   "type": "bullets",
   "items": [
    "If Prod. Month From > Prod. Month To, display message no. 1. Stop.",
    "Retrieve POs by PO Number (partial), production month range and Status within the user data scope.",
    "If no data, show 'No Data Found' (message no. 2)."
