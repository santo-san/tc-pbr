 "general": {
  "objective": [
   "To add, view and edit the distance (KM) between two locations registered in Master Location.",
   "To provide the mileage used by TC-PBR to calculate the variable cost of each delivery: Variable Cost = Mileage (KM) x Price per KM.",
   "To prevent invalid routes: same From / To, mileage <= 0, duplicate From + To, or locations that are not active in Master Location.",
   "To create or update many routes at once from an Excel template, with a preview of the result of every row before saving."
  ],
  "display_order": [
   {
    "section": "Route Mileage List",
    "fields": [
     {
      "field": "From Code",
      "order": "Ascending"
     },
     {
      "field": "To Code",
      "order": "Ascending"
     }
    ]
   }
  ],
  "buttons": [
   {
    "name": "From / To",
    "function": "Searchable drop-down: to select an active location from Master Location by code or name."
   },
   {
    "name": "Mileage",
    "function": "To key-in the distance in KM."
   },
   {
    "name": "Save",
    "function": "To validate and save: insert in Add Mode, update in Edit Mode."
   },
   {
    "name": "Cancel",
    "function": "Clear criteria and reset the screen to its initial value (Add Mode)."
   },
   {
    "name": "Search",
    "function": "To filter the list by keyword."
   },
   {
    "name": "Table View",
    "function": "To show / hide list columns."
   },
   {
    "name": "Export .xls",
    "function": "To export the filtered list to Excel."
   },
   {
    "name": "Row click",
    "function": "Change the screen into Edit Mode with the selected route loaded."
   },
   {
    "name": "Pagination",
    "function": "To move between pages and set rows per page."
   },
   {
    "name": "Upload Excel",
    "function": "To select the Excel file and show the upload preview (nothing saved yet)."
   },
   {
    "name": "Download Template",
    "function": "To download the Excel template (Route Mileage, Active Locations, Notes)."
   },
   {
    "name": "Confirm Upload",
    "function": "To save all New and Update rows of the previewed file (all-or-nothing)."
   }
  ],
