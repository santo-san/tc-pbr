   "text": "5.3 Detail and Download",
   "level": 0
  },
  {
   "type": "item",
   "marker": "a.",
   "text": "User clicks 'PR Number': open 'Detail PR for #<No>' modal with the route detail (10 rows per page, sortable by Route, searchable) and the totals footer: '% Sharing Percentage for <Code>', 'Total QTY', 'Total. Price'.",
   "level": 2
  },
  {
   "type": "item",
   "marker": "b.",
   "text": "Route Percentage = route Qty Total / document Total Qty (TBD, OP-09). Price Total = Qty 20 x Price 20 + Qty 40 x Price 40.",
