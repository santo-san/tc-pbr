 "general": {
  "objective": [
   "To let VPLD monitor the Service Acceptance approved in SA Approval (SA Number generated), with deliveries and approved cost.",
   "To monitor the ELIPS -> PAS interface and the PAS feedback: PAS PR Number, PAS PR Date, PAS PO Number, interface status and errors.",
   "To keep ELIPS (SA Approval snapshot) and PAS data clearly separated for 3-way matching and audit."
  ],
  "display_order": [
   {
    "section": "Service Acceptance List / WBS Group",
    "fields": [
     {
      "field": "SA Approval Date",
      "order": "Descending"
     },
     {
      "field": "SA Number",
      "order": "Ascending"
     }
    ]
   }
  ],
  "buttons": [
   {
    "name": "Search",
    "function": "To retrieve SA by the criteria."
   },
   {
    "name": "Cancel",
    "function": "To reset the criteria."
   },
   {
    "name": "Status chip",
    "function": "To filter by interface status."
   },
   {
    "name": "Tabs",
    "function": "To switch list / WBS Group / Inter Plant."
   },
   {
    "name": "Export Excel",
    "function": "To download the current list."
   },
   {
    "name": "View Detail",
    "function": "To show SA detail A-G."
   },
   {
    "name": "Interface Log",
    "function": "To show the interface events."
   },
   {
    "name": "Retry Interface",
    "function": "To resend a failed SA to PAS."
   }
  ],
  "screen_modes": [
   {
    "mode": "VPLD (Planner)",
    "sections": [
     {
