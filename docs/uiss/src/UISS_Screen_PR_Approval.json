 "general": {
  "objective": [
   "To let VPLD approvers (SH, DpH, DH) approve or reject monthly PRs, one by one or in bulk.",
   "To let a higher level approve directly; lower levels still Pending become Skip.",
   "To create the PO automatically when the PR is approved by DH."
  ],
  "display_order": [
   {
    "section": "List",
    "fields": [
     {
      "field": "Production Month",
      "order": "Ascending"
     },
     {
      "field": "PR Number",
      "order": "Ascending"
     }
    ]
   },
   {
    "section": "Detail PR - Route",
    "fields": [
     {
      "field": "Route",
      "order": "Ascending"
     }
    ]
   },
   {
    "section": "Detail PR - Approval History",
    "fields": [
     {
      "field": "Action date time",
      "order": "Descending"
     }
    ]
   }
  ],
  "buttons": [
   {
    "name": "Search",
    "function": "To retrieve records according to the specified criteria."
   },
   {
    "name": "Clear",
    "function": "Clear criteria and reset the screen to its initial value."
   },
   {
    "name": "Kolom",
    "function": "To show / hide column groups of the list."
   },
   {
    "name": "Select",
    "function": "To tick documents to be processed (row and select-all check box)."
   },
   {
    "name": "Approve",
    "function": "To approve the ticked PRs after confirmation."
   },
   {
    "name": "Reject",
    "function": "To reject the ticked PRs with Reason after confirmation."
   },
   {
    "name": "PR Number link",
    "function": "To open Detail PR modal (route detail and approval history)."
   },
   {
    "name": "Download",
    "function": "To download the route detail of the PR as CSV."
   },
   {
    "name": "Modal Approve",
    "function": "To approve the PR shown in the detail modal."
   },
   {
    "name": "Modal Reject",
    "function": "To reject the PR shown in the detail modal."
   },
   {
    "name": "Submit",
    "function": "Approve / Reject button in the confirmation modal: to save the decision."
   },
   {
    "name": "Batal",
    "function": "To close the confirmation modal without saving."
   },
   {
    "name": "Close (x)",
    "function": "To close the modal."
   }
  ],
