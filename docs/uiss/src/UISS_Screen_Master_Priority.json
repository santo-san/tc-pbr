 "operation": [
  {
   "type": "heading",
   "text": "5.1 Initial Display",
   "level": 0
  },
  {
   "type": "item",
   "marker": "a.",
   "text": "Title 'Master Priority', breadcrumb 'Master - Master Priority' (menu Master > Priority).",
   "level": 2
  },
  {
   "type": "item",
   "marker": "b.",
   "text": "Input Section in Add Mode: From = 'Select From', To = 'Select To', Priority blank ('Enter Priority').",
   "level": 2
  },
  {
   "type": "item",
   "marker": "c.",
   "text": "From / To list: ACTIVE locations of Master Location, 'Code - Name', sorted by code; searchable by code or name.",
   "level": 2
  },
  {
   "type": "item",
   "marker": "d.",
   "text": "Priority List sorted by Priority ascending, 20 rows per page (TBD). No data: message no. 14.",
   "level": 2
  },
  {
   "type": "item",
   "marker": "e.",
   "text": "From / To Description from Master Location; Trip = From + To code; Mileage = active mileage of the route in Master Mileage.",
   "level": 2
  },
  {
   "type": "heading",
   "text": "5.2 Priority Numbering (PR-05)",
   "level": 0
  },
  {
   "type": "item",
   "marker": "a.",
   "text": "Priority 1 is the highest. Numbers are always 1..n without gaps and without duplicates.",
   "level": 2
  },
  {
   "type": "item",
   "marker": "b.",
   "text": "Every add, edit, move and delete renumbers the list in the same DB transaction.",
   "level": 2
  },
  {
   "type": "heading",
   "text": "5.3 Save (Add / Edit)",
   "level": 0
  },
  {
   "type": "bullets",
   "items": [
    "Step 1 - From (no. 1) and To (no. 2) required; From <> To (no. 3); both ACTIVE in Master Location (no. 4). Messages under the field. Stop.",
    "Step 2 - From + To must not have a priority yet, excluding the edited record (no. 5). Stop.",
    "Step 3 - Route must be Active in Master Mileage (no. 6). Stop.",
    "Step 4 - Priority blank or whole number 1..n+1 (Add) / 1..n (Edit) (no. 7). Stop.",
    "Step 5 - Edit: version check (no. 8).",
    "Step 6 - Add: p = input or n+1. Edit: p = input or current priority. Put the route at p; routes from p onward shift by one.",
    "Success: reset form to Add Mode, refresh list on the page of the saved route, highlight it, message no. 9 / 10."
   ],
   "marker": "1.",
   "level": 3
  },
  {
   "type": "table",
   "columns": [
    {
     "title": "Action",
     "width": 18
    },
    {
     "title": "Before",
     "width": 14
    },
    {
     "title": "After",
     "width": 14
    }
   ],
   "rows": [
    [
     "Add SNT -> KRW, priority 3",
     "A1 B2 C3 D4",
     "A1 B2 SNT-KRW3 C4 D5"
    ],
    [
     "Add, priority blank",
     "A1 B2 C3",
     "A1 B2 C3 new4"
    ],
    [
     "Edit C priority 3 -> 1",
     "A1 B2 C3",
     "C1 A2 B3"
    ],
    [
     "Delete B",
     "A1 B2 C3",
     "A1 C2"
    ]
   ],
   "level": 2,
   "row_lines": "all"
  },
  {
   "type": "heading",
   "text": "5.4 Up / Down (PR-06)",
   "level": 0
  },
  {
   "type": "item",
   "marker": "a.",
   "text": "Up swaps the priority with the route above; Down with the route below. Up disabled on 1, Down disabled on n.",
   "level": 2
  },
  {
   "type": "item",
   "marker": "b.",
   "text": "Both swapped routes get Changed By / Changed DT; message no. 11. The page follows the moved route.",
   "level": 2
  },
  {
   "type": "item",
   "marker": "c.",
   "text": "In Edit Mode the form is reset to Add Mode first.",
   "level": 2
  },
  {
   "type": "column_break"
  },
  {
   "type": "heading",
   "text": "5.5 Delete (PR-07)",
   "level": 0
  },
  {
   "type": "item",
   "marker": "a.",
   "text": "Confirmation message no. 12 (buttons Batal / Delete).",
   "level": 2
  },
  {
   "type": "item",
   "marker": "b.",
   "text": "Delete: remove the route, routes below move up by one; message no. 13. Physical delete (TBD, OP-04).",
   "level": 2
  },
  {
   "type": "heading",
   "text": "5.6 Search, Kolom, Export XLS",
   "level": 0
  },
  {
   "type": "item",
   "marker": "a.",
   "text": "Search filters immediately on all columns; no match: message no. 15.",
   "level": 2
  },
  {
   "type": "item",
   "marker": "b.",
   "text": "Kolom shows / hides columns; Action is always shown.",
   "level": 2
  },
  {
   "type": "item",
   "marker": "c.",
   "text": "Export XLS exports all rows matching Search with the visible columns; Mileage and Priority exported as numbers.",
   "level": 2
  },
  {
   "type": "heading",
   "text": "5.7 Trucking Payment by Resource (PR-11)",
   "level": 0
  },
  {
   "type": "item",
   "marker": "a.",
   "text": "Candidate routes are ordered by priority (lowest number first); routes without priority come last.",
   "level": 2
  },
  {
   "type": "item",
   "marker": "b.",
   "text": "Exact use of the priority in the payment calculation: TBD (OP-01).",
   "level": 2
  },
  {
   "type": "heading",
   "text": "5.8 Security and Audit",
   "level": 0
  },
  {
   "type": "item",
   "marker": "a.",
   "text": "Access follows the existing role framework (View / Add / Edit / Delete / Export Master Priority, TBD).",
   "level": 2
  },
  {
   "type": "item",
   "marker": "b.",
   "text": "Audit fields: Created DT, Created By, Changed DT, Changed By (format DD/MM/YYYY HH:MI).",
   "level": 2
  }
 ],
