 "general": {
  "objective": [
   "To maintain the priority order of routes (From -> To) used as the reference for Trucking Payment by Resource.",
   "To add a route at a given priority, change its priority (edit or up / down) and delete it, keeping the numbers 1..n without gaps.",
   "To ensure every route uses active locations of Master Location and is registered in Master Mileage."
  ],
  "display_order": [
   {
    "section": "Priority List",
    "fields": [
     {
      "field": "Priority",
      "order": "Ascending"
     }
    ]
   }
  ],
  "buttons": [
   {
    "name": "From / To",
    "function": "Searchable drop-down: to select an active location from Master Location by code or name."
   },
   {
    "name": "Priority",
    "function": "To key-in the priority number (optional)."
   },
   {
    "name": "Cancel",
    "function": "Clear criteria and reset the screen to its initial value (Add Mode)."
   },
   {
    "name": "Save",
    "function": "To validate and save: insert in Add Mode, update in Edit Mode, renumber the other routes."
   },
   {
    "name": "Search",
    "function": "To filter the list by keyword."
   },
   {
    "name": "Kolom",
    "function": "To show / hide list columns."
   },
   {
    "name": "Export XLS",
    "function": "To export the filtered list to Excel."
   },
   {
    "name": "Up / Down",
    "function": "To swap the priority of the row with the row above / below."
   },
   {
    "name": "Edit",
    "function": "Change the screen into Edit Mode with the selected route loaded."
   },
   {
    "name": "Delete",
    "function": "To delete the route after confirmation and renumber the routes below."
   },
   {
    "name": "Pagination",
    "function": "To move between pages."
   }
  ],
