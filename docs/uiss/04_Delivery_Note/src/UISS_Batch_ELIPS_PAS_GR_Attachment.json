 "func_desc": [
  {
   "type": "heading",
   "text": "DESCRIPTION",
   "num": "4."
  },
  {
   "type": "text",
   "text": "A scheduled Talend job gets the ELIPS Surat Jalan PDF(s) of every PAS GR waiting for its attachment, uploads them to the PAS FTP / SFTP and only then sets RIGHT(TB_R_PR_H.PR_NOTES,1) = '1' and TB_R_GR_IR.SOURCE_TYPE = '1', so that PAS Auto GR can continue. No PDF upload = no indicator update.",
   "level": 1,
   "bold": false
  },
  {
   "type": "text",
   "text": "4.1 Identification",
   "level": 1,
   "bold": true
  },
  {
   "type": "item",
   "marker": "a.",
   "text": "GR -> PO -> PR via PAS keys (TBD); PR_DESC = ELIPS SA_NUMBER; PR_ITEM_NO = ITEM_NO for item-level GR.",
   "level": 2
  },
  {
   "type": "item",
   "marker": "b.",
   "text": "SA_DETAIL rows must already hold PAS_PR_NUMBER / PAS_PO_NUMBER equal to PAS (callback complete); not identified by weak attributes.",
   "level": 2
  },
  {
   "type": "item",
   "marker": "c.",
   "text": "Surat Jalan = one PDF per finished cycle (Delivery ID = No Cycle Order); a GR has 1..n PDFs (OQ-G08).",
   "level": 2
  },
  {
   "type": "text",
   "text": "4.2 PDF validation",
   "level": 1,
   "bold": true
  },
  {
   "type": "item",
   "marker": "a.",
   "text": "HTTP 200, contentType application/pdf; deliveryId and orderNo equal to the request / SA_DETAIL.",
   "level": 2
  },
  {
   "type": "item",
   "marker": "b.",
   "text": "Base64 decodes; size > 0 and = API size; starts '%PDF-', ends '%%EOF'; staging file readable; extension .pdf.",
   "level": 2
  },
  {
   "type": "text",
   "text": "4.3 Upload",
   "level": 1,
   "bold": true
  },
  {
   "type": "item",
   "marker": "a.",
   "text": "SFTP preferred; put .part, compare size, rename .pdf. Existing file: skip only if logged with same dataHash, else FILE_EXISTS (no overwrite unless CB_REPLACE_EXISTING = 'Y').",
   "level": 2
  },
  {
   "type": "item",
   "marker": "b.",
   "text": "File name: PAS convention; else proposal ELIPS_<SA_NUMBER '/'->'-'>_<PO>_<DELIVERY_ID>.pdf - not implemented before OQ-G07.",
   "level": 2
  },
  {
   "type": "column_break"
  },
  {
   "type": "text",
   "text": "4.4 Indicator update",
   "level": 1,
   "bold": true
  },
  {
   "type": "item",
   "marker": "a.",
   "text": "One PAS transaction per GR after all files are uploaded. PR_NOTES: last character only, 0 -> 1, value as read, LIKE CB_PRNOTES_PATTERN; already '1' = OK. Disabled by CB_PRNOTES_UPDATE_ENABLED = 'N' until OQ-G04.",
   "level": 2
  },
  {
   "type": "item",
   "marker": "b.",
   "text": "SOURCE_TYPE = '1' by the full GR key; rows = 1; already '1' = ALREADY_DONE.",
   "level": 2
  },
  {
   "type": "text",
   "text": "4.5 Idempotency / retry",
   "level": 1,
   "bold": true
  },
  {
   "type": "item",
   "marker": "a.",
   "text": "File log (GR + Delivery ID + dataHash) prevents duplicate uploads; SOURCE_TYPE '1' ends the GR; failed GR stays eligible; RETRY_COUNT, alert at CB_MAX_RETRY.",
   "level": 2
  },
  {
   "type": "text",
   "text": "4.6 Context / security",
   "level": 1,
   "bold": true
  },
  {
   "type": "item",
   "marker": "a.",
   "text": "ELIPS / PAS DB host, port, name, user, password; PAS FTP host, port, user, password / key, target dir; staging dir; ENV DEV / SIT / UAT / PROD; ELIPS API URL + service account. Secrets in the Talend / environment secret store, never in SQL, code or Git, never logged.",
   "level": 2
  },
  {
   "type": "text",
   "text": "4.7 Open questions",
   "level": 1,
   "bold": true
  },
  {
   "type": "table",
   "level": 1,
   "columns": [
    {
     "title": "ID",
     "width": 6
    },
    {
     "title": "Question",
     "width": 39
    }
   ],
   "rows": [
    [
     "OQ-G01",
     "ELIPS production: Surat Jalan generated on the fly with a Base64 API (endpoint, auth, service account) or stored (BLOB / path)?"
    ],
    [
     "OQ-G02",
     "SA_DETAIL ORDER_NO column; ELIPS cycle table (No Cycle Order, cycle no, finish time)"
    ],
    [
     "OQ-G03",
     "TB_R_GR_IR unique key, PO / PO item columns, created date, GR status"
    ],
    [
     "OQ-G04",
     "PR_NOTES format and meaning of 0 / 1; who sets '0' (forward code inserts NULL)"
    ],
    [
     "OQ-G05",
     "SOURCE_TYPE values; condition 'waiting for ELIPS attachment'"
    ],
    [
     "OQ-G06",
     "SFTP or FTP, host / port / auth per env, directory, permissions"
    ],
    [
     "OQ-G07",
     "PAS file naming convention (proposal ELIPS_<SA_SAFE>_<PO>_<DELIVERY_ID>.pdf)"
    ],
    [
     "OQ-G08",
     "How Auto GR links file to GR; several files per GR or one PDF; does Auto GR read the indicators?"
    ],
    [
     "OQ-G09",
     "Set CHANGED_BY / CHANGED_DT on PAS tables?"
    ],
    [
     "OQ-G10",
     "Existing file with other content: replace / version / block?"
    ],
    [
     "OQ-G11",
     "Location of log tables; alert receivers"
    ],
    [
     "OQ-G12",
     "GR granularity: PO / PO item / delivery"
    ],
    [
     "OQ-G13",
     "Schedule, lookback, batch size, max retry"
    ]
   ],
   "row_lines": "all"
  }
 ],
