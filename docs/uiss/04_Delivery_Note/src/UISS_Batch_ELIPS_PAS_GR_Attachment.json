   }
  },
  {
   "event": "Update PAS",
   "cause": "SOURCE_TYPE already '1'",
   "type": "Info",
   "msg_id": "TBD",
   "message": "GR <GR_KEY>: SOURCE_TYPE already 1.",
   "action": {
    "system": "ALREADY_DONE",
    "user": "-"
   }
  },
  {
   "event": "Update PAS",
   "cause": "DB error / rows affected <> 1",
   "type": "Error",
   "msg_id": "TBD",
   "message": "GR <GR_KEY>: indicator update failed: <DB_ERROR>; rolled back.",
   "action": {
    "system": "Rollback; GR FAILED (DB_UPDATE_FAILED)",
    "user": "Retry next run"
   }
  },
  {
   "event": "Update PAS",
   "cause": "GR completed",
   "type": "Info",
   "msg_id": "TBD",
   "message": "GR <GR_KEY>: <n> files; PR <PR_NO> PR_NOTES <UPDATED|ALREADY_1>; SOURCE_TYPE <before> -> 1.",
   "action": {
    "system": "Commit; GR log SUCCESS",
    "user": "-"
   }
  },
  {
   "event": "Retry",
   "cause": "RETRY_COUNT reached maximum",
   "type": "Warning",
   "msg_id": "TBD",
   "message": "GR <GR_KEY> failed <n> times: <REASON_CD>.",
   "action": {
    "system": "Alert; processed once a day",
    "user": "Support team"
   }
  },
  {
   "event": "Process end",
   "cause": "Run finished",
   "type": "Info",
   "msg_id": "TBD",
   "message": "GR attachment finished: candidates <n>, success <n>, skipped <n>, failed <n>, files <n>.",
   "action": {
    "system": "Update run log",
    "user": "-"
   }
  },
  {
   "event": "Processing",
   "cause": "Unexpected Talend error",
   "type": "Critical",
   "msg_id": "TBD",
   "message": "GR attachment stopped: <ERROR>.",
   "action": {
    "system": "Rollback current GR; run log FAILED",
    "user": "Contact system administrator"
   }
  }
