  "steps": [
   {
    "text": "Scheduled start (single instance). Connections from context / secret store: cnx_PAS (auto-commit OFF, XACT_ABORT ON), cnx_ELIPS, cnx_FTP (SFTP if PAS supports it). Insert ielp.LOG_ITGPAS (inferred); log message no. 1.",
    "children": [
     "DB error: log message no. 2. FTP: log message no. 3 / log message no. 4. Stop."
    ]
   },
   {
    "text": "Select eligible GR (spec D.1): TB_R_GR_IR SOURCE_TYPE <> '1' (waiting condition TBD - Requires PAS table/column confirmation) -> TB_R_PO_H -> <PAS_PO_PR_LINK> -> TB_R_PR_H with RIGHT(PR_NOTES,1) IN ('0','1') and TB_T_JOB_AUTOPO CREATED_BY 'ILSTC'; lookback, batch size.",
    "children": [
     "None: log message no. 5. Diagnostic count of unexpected PR_NOTES: log message no. 6."
    ]
   },
   {
    "text": "Per GR: read attachment log; SA_DETAIL where SA number = PR_DESC [+ ITEM_NO = PR_ITEM_NO]; all rows must have PAS_PR_NUMBER = PR_NO and PAS_PO_NUMBER = PO (callback complete); read finished cycles -> Delivery IDs (TBD - Requires ELIPS table/column confirmation).",
    "children": [
     "log message no. 7; log message no. 8; log message no. 9."
    ]
   },
   {
    "text": "Per Delivery ID not yet uploaded: call the existing ELIPS Delivery Note Base64 API; decode; validate (Functional Description 4.2); write staging file.",
    "children": [
     "log message no. 10; log message no. 11; log message no. 12."
    ]
   },
   {
    "text": "Check target file (log + FTP list); put <name>.part; compare remote size; rename to <name>.pdf; verify; file log UPLOADED.",
    "children": [
     "log message no. 14; log message no. 13; log message no. 15; log message no. 16."
    ]
   },
   {
    "text": "Decision: every Delivery ID of the GR is UPLOADED / ALREADY_UPLOADED (same dataHash)?",
    "children": [
     "No: GR FAILED with the first reason; PR_NOTES / SOURCE_TYPE NOT updated; retry next run (log message no. 22)."
    ]
   },
   {
    "text": "PAS transaction: UPDATE TB_R_PR_H last character 0 -> 1 (PR_NO, value as read, pattern CB_PRNOTES_PATTERN); UPDATE TB_R_GR_IR SOURCE_TYPE = '1' by the full GR key (1 row); COMMIT.",
    "children": [
     "Already '1': not an error. log message no. 18; log message no. 17; log message no. 19; log message no. 20; success log message no. 21."
    ]
   },
   {
    "text": "Insert ielp.LOG_ITGPAS (inferred) (SOURCE_TYPE before / after, PR_NOTES status, result); delete staging files; next GR (errors never affect another GR)."
   },
   {
    "text": "Update ielp.LOG_ITGPAS (inferred) totals and status; log message no. 23. Unexpected error: log message no. 24."
   }
  ]
 },
