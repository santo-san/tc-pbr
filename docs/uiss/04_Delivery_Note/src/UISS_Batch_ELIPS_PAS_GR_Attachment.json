    "type": "DB (PAS)",
    "description": "Last character 0 -> 1"
   },
   {
    "name": "TB_R_GR_IR.SOURCE_TYPE",
    "type": "DB (PAS)",
    "description": "'1'"
   },
   {
    "name": "ielp.LOG_ITGPAS (inferred) / ielp.LOG_ITGPAS (inferred) / ielp.LOG_ITGPAS (inferred)",
    "type": "DB",
    "description": "Logs (proposed)"
   }
  ],
