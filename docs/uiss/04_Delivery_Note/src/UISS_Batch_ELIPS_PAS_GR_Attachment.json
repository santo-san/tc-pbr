    "system": "File log UPLOADED",
    "user": "-"
   }
  },
  {
   "event": "Update PAS",
   "cause": "PR_NOTES changed since read / pattern not matched",
   "type": "Error",
   "msg_id": "TBD",
   "message": "PR <PR_NO>: PR_NOTES '<PR_NOTES>' unexpected; indicators not updated.",
   "action": {
    "system": "Rollback; GR FAILED (PRNOTES_UNEXPECTED)",
    "user": "PAS check"
   }
  },
  {
   "event": "Update PAS",
   "cause": "PR_NOTES update disabled (format not confirmed)",
