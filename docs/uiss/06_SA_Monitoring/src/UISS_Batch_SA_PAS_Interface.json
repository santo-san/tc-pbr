 "logging_messages": [
  {
   "event": "Send SA",
   "cause": "SA not in NOT_SENT / FAILED",
   "type": "Error",
   "msg_id": "TBD",
   "message": "SA {SA} is {STATUS}, cannot be sent (409 NOT_SENDABLE).",
   "action": {
    "system": "Reject",
    "user": "-"
   }
  },
  {
   "event": "Send SA (retry)",
   "cause": "User without retry authorization",
   "type": "Error",
   "msg_id": "TBD",
   "message": "Retry Interface needs the retry authorization (403 FORBIDDEN).",
   "action": {
    "system": "Reject",
    "user": "IELP Admin retries"
   }
  },
  {
   "event": "Send SA (retry)",
   "cause": "PAS already returned PR / PO",
   "type": "Error",
   "msg_id": "TBD",
   "message": "PAS already returned data; the failed PAS step is handled in PAS (no resend) (409 PAS_STEP_FAILED).",
   "action": {
    "system": "Reject",
    "user": "Handle in PAS"
   }
  },
  {
   "event": "Send SA",
   "cause": "SA data incomplete",
   "type": "Error",
   "msg_id": "TBD",
   "message": "SA data incomplete (SA Number / deliveries / cost) (422 INVALID_REQUEST).",
   "action": {
    "system": "Status FAILED, log",
    "user": "Correct the SA"
   }
  },
  {
   "event": "Send SA",
   "cause": "PAS unavailable / timeout / invalid / rejected",
   "type": "Error",
   "msg_id": "TBD",
   "message": "PAS_UNAVAILABLE / TIMEOUT / INVALID_REQUEST / PAS_REJECTED: <message> (502).",
   "action": {
    "system": "Status FAILED, log",
    "user": "Retry"
   }
  },
  {
   "event": "Send SA",
   "cause": "Accepted by PAS",
   "type": "Info",
   "msg_id": "TBD",
   "message": "SA {SA} sent to PAS (200 SENT).",
   "action": {
    "system": "Status SENT, interface time",
    "user": "-"
   }
  },
  {
   "event": "Feedback",
   "cause": "Missing feedback id / SA / type",
   "type": "Error",
   "msg_id": "TBD",
   "message": "Feedback id, SA Number and type are mandatory (400 INVALID_FORMAT).",
   "action": {
    "system": "Reject",
    "user": "PAS resends"
   }
  },
  {
   "event": "Feedback",
   "cause": "Same feedback id again",
   "type": "Info",
   "msg_id": "TBD",
   "message": "Feedback {ID} already processed, ignored (DUPLICATE).",
   "action": {
    "system": "Ignore",
    "user": "-"
   }
  },
  {
   "event": "Feedback",
   "cause": "SA unknown",
   "type": "Error",
   "msg_id": "TBD",
   "message": "SA {SA} not found in ELIPS (404 UNKNOWN_SA).",
   "action": {
    "system": "Reject",
    "user": "Check SA"
   }
  },
  {
   "event": "Feedback",
   "cause": "Correlation id differs / SA not sent",
   "type": "Error",
   "msg_id": "TBD",
   "message": "409 CORRELATION_MISMATCH / NOT_SENT.",
   "action": {
    "system": "Record REJECTED",
    "user": "-"
   }
  },
  {
   "event": "Feedback",
   "cause": "PR / PO number missing or conflicting / duplicated",
   "type": "Error",
   "msg_id": "TBD",
   "message": "422 MISSING_PR_NO / MISSING_PR_DATE / MISSING_PO_NO; 409 PR_CONFLICT / PO_CONFLICT / DUPLICATE_PR / DUPLICATE_PO.",
   "action": {
    "system": "Record REJECTED, values not overwritten",
    "user": "Correct in PAS"
   }
  },
  {
   "event": "Feedback",
   "cause": "PAS error feedback",
   "type": "Error",
   "msg_id": "TBD",
   "message": "PAS error {CODE} recorded.",
   "action": {
    "system": "Status FAILED",
    "user": "Retry Interface"
   }
  },
  {
   "event": "Feedback",
   "cause": "PR / PO received",
   "type": "Info",
   "msg_id": "TBD",
   "message": "SA {SA}: PR_RECEIVED / PO_RECEIVED / COMPLETED.",
   "action": {
    "system": "Update PAS columns, log",
    "user": "-"
   }
  },
  {
   "event": "Feedback",
   "cause": "DB update failed",
   "type": "Error",
   "msg_id": "TBD",
   "message": "Database update failed, feedback not saved (500 DB_ERROR; PAS may resend).",
   "action": {
    "system": "Rollback",
    "user": "-"
   }
  }
 ],
