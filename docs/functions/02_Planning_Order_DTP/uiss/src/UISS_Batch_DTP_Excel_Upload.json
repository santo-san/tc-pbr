 "general": {
  "objective": [
   "To validate the DTP Excel template uploaded on the DTP Creation screen and add the records to the delivery grid (ielp.DTP_2_DETAIL) only when every row is valid.",
   "In case any row fails, nothing is added and the full error list (Row / Column / Error) is returned to the screen; the planner corrects the file and uploads again."
  ],
  "operation_flow": {
   "flow": {
    "direction": "TB",
    "nodes": [
     {
      "id": "a",
      "label": "VPLD Planner: Choose File",
      "type": "event"
     },
     {
      "id": "b",
      "label": "Excel file",
      "type": "document"
     },
     {
      "id": "c",
      "label": "Upload batch: check, temp, validate",
      "type": "process"
     },
     {
      "id": "d",
      "label": "All rows valid?",
      "type": "decision"
     },
     {
      "id": "e",
      "label": "ielp.DTP_2_DETAIL",
      "type": "db"
     },
     {
      "id": "f",
      "label": "Error list to screen",
      "type": "message"
     }
    ],
    "edges": [
     {
      "from": "a",
      "to": "b"
     },
     {
      "from": "b",
      "to": "c"
     },
     {
      "from": "c",
      "to": "d"
     },
     {
      "from": "d",
      "to": "e",
      "label": "Yes"
     },
     {
      "from": "d",
      "to": "f",
      "label": "No"
     }
    ]
   },
   "note": "Proposed backend pattern (uiss-batch-guide 11)."
  },
  "inputs": [
   {
    "name": "Format DTP (.xlsx / .xls)",
    "type": "Excel",
    "description": "One file per run; header row with ROUNDUSE (row 7 in format_DTP2_1.xlsx)"
   },
   {
    "name": "Plan date, Operation Type, user",
    "type": "Screen",
    "description": "From the DTP Creation header"
   },
   {
    "name": "ielp.MS_TRUCKING_COMPANY / Location Master / DTP Data Mapping (TBD)",
    "type": "DB",
    "description": "LP, FROM, TO codes (data mapping)"
   },
   {
    "name": "ielp.DTP_2_DETAIL",
    "type": "DB",
    "description": "Duplicate check (STATUS <> FAILED)"
   }
  ],
  "outputs": [
   {
    "name": "TB_T_DTP_UPLOAD",
    "type": "DB",
    "description": "Raw rows + validation result"
   },
   {
    "name": "ielp.DTP_2_DETAIL",
    "type": "DB",
    "description": "if all rows valid"
   },
   {
    "name": "ielp.LOG_ACTIVITY_ORDER",
    "type": "DB",
    "description": "Status history (AVAILABLE)"
   },
   {
    "name": "TB_R_DTP_UPLOAD_LOG",
    "type": "DB",
    "description": "Result read by the screen"
   }
  ],
  "extra_tables": [
   {
    "title": "Execution",
    "columns": [
     {
      "title": "Item",
      "width": 12
     },
     {
      "title": "Description",
      "width": 30
     }
    ],
    "rows": [
     [
      "Trigger",
      "On-line, from DTP Creation [Choose File]"
     ],
     [
      "Commit",
      "All-or-nothing"
     ],
     [
      "Lock",
      "One running upload per user (Proposed)"
     ],
     [
      "Housekeeping",
      "Temp rows: deleted on success; kept N days on error (TBD)"
     ]
    ]
   }
  ],
  "constraints": [
   "Table names are proposed; align them with the project naming convention.",
   "Partial upload (valid rows only) is not supported (TBD OP-06)."
  ]
 },
