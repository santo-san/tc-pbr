 "func_desc": [
  {
   "type": "heading",
   "text": "4. DESCRIPTION",
   "level": 0
  },
  {
   "type": "text",
   "text": "The batch runs on-line when the planner chooses a file on DTP Creation. Prerequisites: Daily Plan Date inside the System Master range and login user = VPLD Planner (checked by the screen and again here).",
   "level": 1,
   "bold": false
  },
  {
   "type": "heading",
   "text": "4.1 Validations (all errors of every row are collected)",
   "level": 0
  },
  {
   "type": "text",
   "text": "4.1.1 Mandatory",
   "level": 1,
   "bold": true
  },
  {
   "type": "bullets",
   "items": [
    "ROUNDUSE, LP, RENBAN, FROM LOCATION, TO LOCATION, DESTINATION, ETD, CONTAINER SIZE, TRUCK TYPE (template '*'); SERVICE_TYPE from the screen. Error no. 7."
   ],
   "marker": "1.",
   "level": 2
  },
  {
   "type": "text",
   "text": "4.1.2 Options and format",
   "level": 1,
   "bold": true
  },
  {
   "type": "bullets",
   "items": [
    "ROUNDUSE Y / N; CONTAINER SIZE 20 / 40 / 40 HC / 45; SHIFT DAY / NIGHT (optional); CTR DG FLAG blank or DG. Error no. 8.",
    "RENBAN, DESTINATION, CTR BOOKING NO: letters / numbers, max 20. ETD / ARRIVAL DATE: Excel date, serial number, yyyy-mm-dd or dd/mm/yyyy. ARRIVAL TIME HH:MM(:SS). Error no. 11.",
    "CONTAINER NO (optional): spaces / dashes removed; 4 letters (3rd/4th U, J, Z) + 7 digits with ISO 6346 check digit. Error no. 12."
   ],
   "marker": "1.",
   "level": 2
  },
  {
   "type": "text",
   "text": "4.1.3 Master / data mapping",
   "level": 1,
   "bold": true
  },
  {
   "type": "bullets",
   "items": [
    "LP code in ielp.MS_TRUCKING_COMPANY (active); FROM / TO codes in the DTP data mapping. Error no. 9.",
    "TO LOCATION <> FROM LOCATION. Error no. 10."
   ],
   "marker": "1.",
   "level": 2
  },
  {
   "type": "text",
   "text": "4.1.4 Duplicates",
   "level": 1,
   "bold": true
  },
  {
   "type": "bullets",
   "items": [
    "Key = CONTAINER NO, otherwise CTR BOOKING NO (rows with neither are not checked, TBD OP-03).",
    "Same key twice in the file: error on the later row (no. 13).",
    "Key already in ielp.DTP_2_DETAIL with STATUS <> 'FAILED': 'already exists in the grid' (Available / Ready / Validation Error) or 'has already been submitted' (Submitted, Queued, Processing, Processed) (no. 14)."
   ],
   "marker": "1.",
   "level": 2
  },
  {
   "type": "column_break"
  },
  {
   "type": "heading",
   "text": "4.2 Commit",
   "level": 0
  },
  {
   "type": "text",
   "text": "All-or-nothing: only when every row is 'V'. Insert ielp.DTP_2_DETAIL and ielp.LOG_ACTIVITY_ORDER in one transaction; rollback on any DB error (no. 16).",
   "level": 1,
   "bold": false
  },
  {
   "type": "heading",
   "text": "4.3 Result to the screen",
   "level": 0
  },
  {
   "type": "table",
   "columns": [
    {
     "title": "Result",
     "width": 10
    },
    {
     "title": "Returned",
     "width": 34
    }
   ],
   "rows": [
    [
     "SUCCESS",
     "Added rows; the records appear in the grid as Available"
    ],
    [
     "File error",
     "One message (type / size / header / empty)"
    ],
    [
     "Row errors",
     "List Row / Column / Error (all rows, downloadable)"
    ]
   ],
   "level": 1,
   "row_lines": "all"
  },
  {
   "type": "heading",
   "text": "4.4 Example (format_DTP2_1.xlsx)",
   "level": 0
  },
  {
   "type": "table",
   "columns": [
    {
     "title": "Row",
     "width": 4
    },
    {
     "title": "Data",
     "width": 22
    },
    {
     "title": "Result",
     "width": 18
    }
   ],
   "rows": [
    [
     "8",
     "N, PNJ, C1244, D1, K1E, STM, 40 HC, booking ...993",
     "Valid"
    ],
    [
     "9",
     "LP blank",
     "no. 7"
    ],
    [
     "10",
     "Booking ...993 again",
     "no. 13"
    ],
    [
     "11",
     "ROUNDUSE X, size 30, container MSKU1234567",
     "no. 8, 12"
    ]
   ],
   "level": 1,
   "row_lines": "all"
  },
  {
   "type": "text",
   "text": "-> 3 rows failed, nothing added; the planner fixes rows 9-11 and uploads again.",
   "level": 1,
   "bold": false
  },
  {
   "type": "text",
   "level": 1,
   "bold": true,
   "text": "4.x Payment Type (rev 0.3)"
  },
  {
   "type": "item",
   "marker": "a.",
   "level": 2,
   "text": "The template has no Payment Type column (TBD, KM-OQ9). Each saved record gets the default of KM-14; the planner can change it on the DTP Creation screen before submission."
  }
 ],
 "func_desc_layout": "two",
 "logging_messages": [
  {
   "event": "Upload start",
   "cause": "Planner chose a file",
   "type": "Info",
   "msg_id": "TBD",
   "message": "DTP upload <UPLOAD_ID> started by <USER> for plan date <DTP_DATE>, file <FILE_NAME>.",
   "action": {
    "system": "Insert upload log (PROCESSING)",
    "user": "-"
   }
  },
  {
   "event": "Lock check",
   "cause": "Another upload of the same user is running",
   "type": "Error",
   "msg_id": "TBD",
   "message": "Upload rejected: upload <UPLOAD_ID_RUNNING> of <USER> is still running.",
   "action": {
    "system": "Stop",
    "user": "Wait and upload again"
   }
  },
  {
   "event": "File check",
   "cause": "Extension not .xlsx / .xls or file unreadable",
   "type": "Error",
   "msg_id": "TBD",
   "message": "Invalid file. Please upload the Excel template (.xlsx / .xls).",
   "action": {
    "system": "Log ERROR; stop",
    "user": "Use the template"
   }
  },
  {
   "event": "File check",
   "cause": "File larger than the limit (TBD)",
   "type": "Error",
   "msg_id": "TBD",
   "message": "File <FILE_NAME> exceeds the maximum size <MAX_SIZE> (TBD).",
   "action": {
    "system": "Log ERROR; stop",
    "user": "Split the file"
   }
  },
  {
   "event": "File check",
   "cause": "Header row (ROUNDUSE) or template columns missing",
   "type": "Error",
   "msg_id": "TBD",
   "message": "Invalid Excel format: column(s) <COLUMNS> not found. Please use the Download Template format.",
   "action": {
    "system": "Log ERROR; stop",
    "user": "Download the template"
   }
  },
  {
   "event": "File check",
   "cause": "No data row",
   "type": "Error",
   "msg_id": "TBD",
   "message": "The Excel file has no data rows.",
   "action": {
    "system": "Log ERROR; stop",
    "user": "Fill in the file"
   }
  },
  {
   "event": "Row validation",
   "cause": "Mandatory value blank",
   "type": "Error",
   "msg_id": "TBD",
   "message": "Row <ROW_NO>: <COLUMN> is required.",
   "action": {
    "system": "Tag row E",
    "user": "Fill in the value"
   }
  },
  {
   "event": "Row validation",
   "cause": "Value not in options",
   "type": "Error",
   "msg_id": "TBD",
   "message": "Row <ROW_NO>: <COLUMN> \"<VALUE>\" is not valid (<OPTIONS>).",
   "action": {
    "system": "Tag row E",
    "user": "Correct the value"
   }
  },
  {
   "event": "Row validation",
   "cause": "LP / FROM / TO not in data mapping",
   "type": "Error",
   "msg_id": "TBD",
   "message": "Row <ROW_NO>: <COLUMN> \"<VALUE>\" is not registered in the data mapping.",
   "action": {
    "system": "Tag row E",
    "user": "Use a mapped code"
   }
  },
  {
   "event": "Row validation",
   "cause": "TO = FROM",
   "type": "Error",
   "msg_id": "TBD",
   "message": "Row <ROW_NO>: TO LOCATION cannot be the same as FROM LOCATION.",
   "action": {
    "system": "Tag row E",
    "user": "Correct"
   }
  },
  {
   "event": "Row validation",
   "cause": "Code / date / time format",
   "type": "Error",
   "msg_id": "TBD",
   "message": "Row <ROW_NO>: <COLUMN> must be letters / numbers only (max 20). / is not a valid date / time.",
   "action": {
    "system": "Tag row E",
    "user": "Correct"
   }
  },
  {
   "event": "Row validation",
   "cause": "Container No check digit",
   "type": "Error",
   "msg_id": "TBD",
   "message": "Row <ROW_NO>: Check digit Container Number tidak valid (seharusnya <CONTAINER_NO>).",
   "action": {
    "system": "Tag row E",
    "user": "Correct"
   }
  },
  {
   "event": "Row validation",
   "cause": "Same Container / Booking twice in the file",
   "type": "Error",
   "msg_id": "TBD",
   "message": "Row <ROW_NO>: Duplicate <KEY> in row <FIRST_ROW> of the same file.",
   "action": {
    "system": "Tag row E",
    "user": "Remove the duplicate"
   }
  },
  {
   "event": "Row validation",
   "cause": "Container / Booking already in ielp.DTP_2_DETAIL (not Failed)",
   "type": "Error",
   "msg_id": "TBD",
   "message": "Row <ROW_NO>: <KEY> already exists in the grid (status <STATUS>). / has already been submitted (status <STATUS>).",
   "action": {
    "system": "Tag row E",
    "user": "Remove the row"
   }
  },
  {
   "event": "Validation result",
   "cause": "At least one row with error",
   "type": "Error",
   "msg_id": "TBD",
   "message": "<ERROR_ROWS> row(s) failed validation. No record was added. Please correct the file and upload again.",
   "action": {
    "system": "Update log ERROR; return error list; keep temp rows",
    "user": "Correct the file and upload again"
   }
  },
  {
   "event": "Insert records",
   "cause": "DB error during insert",
   "type": "Critical",
   "msg_id": "TBD",
   "message": "Upload <UPLOAD_ID>: insert into ielp.DTP_2_DETAIL failed (<DB_ERROR>). Transaction rolled back.",
   "action": {
    "system": "Rollback; update log ERROR",
    "user": "Upload again / contact administrator"
   }
  },
  {
   "event": "Upload end",
   "cause": "All rows valid and saved",
   "type": "Info",
   "msg_id": "TBD",
   "message": "<ADDED_ROWS> record(s) uploaded and validated. (<FILE_NAME>)",
   "action": {
    "system": "Update log SUCCESS; delete temp rows",
    "user": "-"
   }
  },
  {
   "event": "Any step",
   "cause": "Unexpected system error",
   "type": "Critical",
   "msg_id": "TBD",
   "message": "Upload <UPLOAD_ID> stopped: <EXCEPTION>.",
   "action": {
    "system": "Rollback; log ERROR",
    "user": "Contact administrator"
   }
  }
 ],
