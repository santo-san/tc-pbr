  "steps": [
   {
    "text": "Receive file, Daily Plan Date, Operation Type and login user from the DTP Creation screen; insert TB_R_DTP_UPLOAD_LOG with STATUS 'PROCESSING'.",
    "children": [
     "Log message no. 1."
    ]
   },
   {
    "text": "Check that no other upload of the same user is PROCESSING (Proposed).",
    "children": [
     "If running, log message no. 2; go to step 8."
    ]
   },
   {
    "text": "File check before any data is written:",
    "children": [
     "Extension .xlsx / .xls and readable, else no. 3; size limit TBD (no. 4).",
     "Header row = first row containing ROUNDUSE; all 18 template columns present (any order, '*' and spaces ignored), else no. 5.",
     "At least one data row, else no. 6. Error: go to step 8."
    ]
   },
   {
    "text": "Insert every data row (non-empty) into TB_T_DTP_UPLOAD as text with UPLOAD_ID, Excel ROW_NO and SERVICE_TYPE of the screen; VALIDATION_STATUS 'N'."
   },
   {
    "text": "Validate every row and collect all errors of the row (refer 4.1); update VALIDATION_STATUS 'V' / 'E' and ERROR_MSG."
   },
   {
    "text": "If any row has status 'E':",
    "children": [
     "Log message no. 15; nothing is inserted into ielp.DTP_2_DETAIL (all-or-nothing); go to step 8."
    ]
   },
   {
    "text": "Convert types and insert all rows into ielp.DTP_2_DETAIL (STATUS 'AVAILABLE', DATA_SOURCE 'EXCEL', LAST_UPLOAD_ID) and ielp.LOG_ACTIVITY_ORDER in one transaction.",
    "children": [
     "DB error: rollback, log message no. 16."
    ]
   },
   {
    "text": "Update TB_R_DTP_UPLOAD_LOG (STATUS, counts, MESSAGE, END_DT); success: delete temp rows of the upload, log no. 17. Return the result (counts, or Row / Column / Error list) to the screen. Exit."
   }
  ]
 },
