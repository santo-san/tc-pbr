     },
     {
      "id": "i",
      "label": "IPMS (source TBD)",
      "type": "db"
     },
     {
      "id": "p",
      "label": "Receive new records of the date",
      "type": "process"
     },
     {
      "id": "d",
      "label": "ielp.DTP_2_DETAIL (inferred)",
      "type": "db"
     }
    ],
    "edges": [
