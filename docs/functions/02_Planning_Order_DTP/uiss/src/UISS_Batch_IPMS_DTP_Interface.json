      "to": "d"
     }
    ]
   }
  },
  "inputs": [
   {
    "name": "IPMS DTP data",
    "type": "DB / API",
    "description": "TBD - Not confirmed from existing schema/data/code"
   }
  ],
  "outputs": [
   {
    "name": "ielp.DTP_2_DETAIL",
    "type": "DB",
    "description": "DTP records, data source IPMS (inferred)"
   }
  ],
  "constraints": [
   "Only records not received before for the date are added (dtp.js:60 pullIpms: PULLED[date]).",
   "Received records are validated like Excel / Manual records (dtp-rules.js makeRecord / validate) and keep their status (Ready / Error)."
  ]
 },
 "func_flow": {
  "flow": {
   "direction": "TB",
   "nodes": [
    {
     "id": "s",
     "label": "START (button)",
     "type": "start"
    },
    {
     "id": "c",
     "label": "Call IPMS for the plan date",
     "type": "process",
     "step": 1
    },
    {
     "id": "q",
     "label": "IPMS responding?",
     "type": "decision",
     "step": 2
    },
    {
     "id": "x",
     "label": "Message: interface error",
     "type": "message"
    },
    {
     "id": "a",
     "label": "Add new records, validate, payment type default",
     "type": "process",
     "step": 3
    },
    {
     "id": "e",
     "label": "Toast n records / no new data",
     "type": "end"
    }
   ],
   "same_rank": [
    [
     "q",
     "x"
    ]
   ],
   "edges": [
    {
     "from": "s",
     "to": "c"
    },
    {
     "from": "c",
     "to": "q"
    },
    {
     "from": "q",
     "to": "x",
     "label": "No"
    },
    {
     "from": "q",
     "to": "a",
     "label": "Yes"
    },
    {
     "from": "a",
     "to": "e"
    }
   ]
  },
  "steps": [
   "Show \"Receiving data from IPMS interface...\" and request the records of the selected plan date (dtp.js:703 loadIpms).",
   "IPMS not responding: \"IPMS interface is not responding (simulated). No record was received. Please try again later.\" - nothing added (log 1).",
   "Add only records not received before (first call: initial set, refresh: the rest); each record gets data source IPMS, is validated, gets the default payment type (By Resources while a slot is free, else By Trip - KM-14) and a history entry \"Received from IPMS\" (dtp.js:67 addRecord).",
   "Result: \"n record(s) received from IPMS\" or \"No new data from IPMS\" (log 2 / 3)."
  ]
 },
