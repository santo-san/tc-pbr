 "general": {
  "objective": [
   "To define the routes used in PR creation as a sequence of Master Location stops (START, VIA, END).",
   "To generate Route Code and Route Description and to calculate the route distance automatically.",
   "To maintain the percentage share of each active route (total max 100%) used to split the quantity in PR creation."
  ],
  "display_order": [
   {
    "section": "List Active Route Percentage",
    "fields": [
     {
      "field": "Created Dt (newest first)",
      "order": "Descending"
     }
    ]
   }
  ],
  "buttons": [
   {
    "name": "Location Pick",
    "function": "To add an active location as the last stop of the route."
   },
   {
    "name": "Move / Delete stop",
    "function": "To reorder (up / down) or remove a stop."
   },
   {
    "name": "Percentage",
    "function": "To key-in the route percentage."
   },
   {
    "name": "Save",
    "function": "To validate and save: insert in Add Mode, update in Edit Mode."
   },
   {
    "name": "Clear",
    "function": "Clear criteria and reset the screen to its initial value (Add Mode)."
   },
   {
    "name": "Search",
    "function": "To filter the list by keyword."
   },
   {
    "name": "Kolom",
    "function": "To show / hide list columns."
   },
   {
    "name": "Opsi",
    "function": "Edit: change the screen into Edit Mode. Deactivate: set the route Inactive after confirmation."
   },
   {
    "name": "Percentage in list",
    "function": "To change the percentage directly in the list."
   },
   {
    "name": "Pagination",
    "function": "To move between pages."
   }
  ],
