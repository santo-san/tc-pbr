 "screen_flow": [
  {
   "title": "Screen Flow for Route Percentage",
   "flow": {
    "direction": "LR",
    "nodes": [
     {
      "id": "l",
      "label": "Master Location (active stops)",
      "type": "screen"
     },
     {
      "id": "mi",
      "label": "Master Mileage (leg distance)",
      "type": "screen"
     },
     {
      "id": "s",
      "label": "Route Percentage screen",
      "type": "screen",
      "screen_id": "TBD"
     },
     {
      "id": "pr",
      "label": "PR creation: quantity split by route percentage",
      "type": "subprocess"
     }
    ],
    "edges": [
     {
      "from": "l",
      "to": "s"
     },
     {
      "from": "mi",
      "to": "s"
     },
     {
      "from": "s",
      "to": "pr"
     }
    ]
   }
  },
  {
   "title": "Screen Flow for Building the Route",
   "flow": {
    "direction": "TB",
    "nodes": [
     {
      "id": "s",
      "label": "START",
      "type": "start"
     },
     {
      "id": "ev",
      "label": "On Select of Location Pick",
      "type": "event"
     },
     {
      "id": "q",
      "label": "Active, not the last stop, max 10?",
      "type": "decision"
     },
     {
      "id": "e",
      "label": "Show message no. 1 / 2 / 3",
      "type": "message"
     },
     {
      "id": "a",
      "label": "Add as last stop (END); previous END becomes VIA",
      "type": "process"
     },
     {
      "id": "b",
      "label": "Rebuild Route Code, Description, Distance",
      "type": "process"
     },
     {
      "id": "m",
      "label": "Optional: move / remove stops (rebuild again)",
      "type": "io"
     },
     {
      "id": "x",
      "label": "Ready to Save",
      "type": "end"
     }
    ],
    "edges": [
     {
      "from": "s",
      "to": "ev"
     },
     {
      "from": "ev",
      "to": "q"
     },
     {
      "from": "q",
      "to": "e",
      "label": "No"
     },
     {
      "from": "q",
      "to": "a",
      "label": "Yes"
     },
     {
      "from": "a",
      "to": "b"
     },
     {
      "from": "b",
      "to": "m"
     },
     {
      "from": "m",
      "to": "x"
     }
    ],
    "same_rank": [
     [
      "q",
      "e"
     ]
    ]
   }
  },
  {
   "title": "Screen Flow for Save",
   "flow": {
    "direction": "TB",
    "nodes": [
     {
      "id": "s",
      "label": "START",
      "type": "start"
     },
     {
      "id": "ev",
      "label": "On Click of Save button",
      "type": "event"
     },
     {
      "id": "q1",
      "label": ">= 2 stops, none twice in a row, all active?",
      "type": "decision"
     },
     {
      "id": "e1",
      "label": "Show message no. 4 / 5 / 1",
      "type": "message"
     },
     {
      "id": "q2",
      "label": "Route Code used by an active route?",
      "type": "decision"
     },
     {
      "id": "e2",
      "label": "Show message no. 6",
      "type": "message"
     },
     {
      "id": "q3",
      "label": "Percentage valid and total <= 100%?",
      "type": "decision"
     },
     {
      "id": "e3",
      "label": "Show message no. 7 / 8 / 9",
      "type": "message"
     },
     {
      "id": "w",
      "label": "Insert / update route, stops, distance (Edit: version check)",
      "type": "process"
     },
     {
      "id": "db",
      "label": "ielp.MS_ROUTE_HEADER",
      "type": "db"
     },
     {
      "id": "e",
      "label": "Clear entry, refresh list, msg 11 / 12",
      "type": "end"
     }
    ],
    "edges": [
     {
      "from": "s",
      "to": "ev"
     },
     {
      "from": "ev",
      "to": "q1"
     },
     {
      "from": "q1",
      "to": "e1",
      "label": "No"
     },
     {
      "from": "q1",
      "to": "q2",
      "label": "Yes"
     },
     {
      "from": "q2",
      "to": "e2",
      "label": "Yes"
     },
     {
      "from": "q2",
      "to": "q3",
      "label": "No"
     },
     {
      "from": "q3",
      "to": "e3",
      "label": "No"
     },
     {
      "from": "q3",
      "to": "w",
      "label": "Yes"
     },
     {
      "from": "w",
      "to": "db",
      "style": "dashed"
     },
     {
      "from": "w",
      "to": "e"
     }
    ],
    "same_rank": [
     [
      "q1",
      "e1"
     ],
     [
      "q2",
      "e2"
     ],
     [
      "q3",
      "e3"
     ],
     [
      "w",
      "db"
     ]
    ]
   }
  },
  {
   "title": "Screen Flow for Distance Calculation",
   "flow": {
    "direction": "TB",
    "nodes": [
     {
      "id": "s",
      "label": "For each leg From -> To",
      "type": "start"
     },
     {
      "id": "q",
      "label": "Active in Master Mileage?",
      "type": "decision"
     },
     {
      "id": "mm",
      "label": "ielp.TB_M_MILEAGE",
      "type": "db"
     },
     {
      "id": "a",
      "label": "Use Master Mileage KM",
      "type": "process"
     },
     {
      "id": "b",
      "label": "Straight-line distance from Master Location coordinates (estimate)",
      "type": "process"
     },
     {
      "id": "t",
      "label": "Distance = sum of legs; mark est. if any estimate",
      "type": "end"
     }
    ],
    "edges": [
     {
      "from": "s",
      "to": "q"
     },
     {
      "from": "q",
      "to": "mm",
      "style": "dashed"
     },
     {
      "from": "q",
      "to": "a",
      "label": "Yes"
     },
     {
      "from": "q",
      "to": "b",
      "label": "No"
     },
     {
      "from": "a",
      "to": "t"
     },
     {
      "from": "b",
      "to": "t"
     }
    ],
    "same_rank": [
     [
      "q",
      "mm"
     ]
    ]
   }
  }
 ],
